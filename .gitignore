# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# El .env real lo crea a mano el bootstrap del servidor
# (/opt/apps/coipo_cabania/.env, chmod 600) y el pipeline lo excluye del rsync
# para que sobreviva a cada deploy. Acá solo se versiona la plantilla.
.env
.env.*
!.env.example

# Datos persistentes de volúmenes. Hoy no hay ninguno; el pipeline ya excluye
# data/ del rsync, así que queda declarado por si la fase 2 los trae.
data/

# Herramientas locales, ajenas al proyecto (CLI de Claude Code instalado en la raíz)
/package.json
/package-lock.json
.claude/settings.local.json
.claude/*.lock

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
