# Plantilla del `.env`. ESTE ARCHIVO SÍ SE VERSIONA; el `.env` real NUNCA.
#
# El `.env` de verdad lo crea el bootstrap en el servidor, en
# /opt/apps/<repo>/.env, y no pasa por GitHub ni por los logs. El reusable de
# despliegue lo excluye del rsync con `--exclude='/.env'` ANCLADO a la raíz —así
# que un `.env` en un subdirectorio SÍ viaja al servidor: no los crees.
#
# Guía 8, punto 3: las seis de abajo son las de infraestructura, y NO alcanzan
# para ninguna aplicación. Antes de desplegar hay que leer
# `backend/app/composicion/ajustes.py` y añadir aquí todo lo que el proceso
# exija sin valor por defecto. Si una falta en el servidor, el contenedor
# arranca, falla el healthcheck, y todo el `docker compose up` se cae con
# "dependency failed to start".

# ── Base de datos ────────────────────────────────────────────────────────────
# CINCO variables separadas, jamás una DATABASE_URL única: esa metería la
# contraseña en una sola cadena que acaba entera en un log de SQLAlchemy o en
# una captura de pantalla. La URL se compone en el código.
DATABASE_HOST=<ip-del-postgres-compartido>
DATABASE_PORT=5432
DATABASE_USER=<rol-de-esta-aplicacion>
DATABASE_PASSWORD=<lo-entrega-quien-administra-la-base>
DATABASE_NAME=<base-de-esta-aplicacion>

# ── Puerto publicado en la VM ────────────────────────────────────────────────
# 8080 es un EJEMPLO. El puerto real es único por VM y hay que confirmarlo antes
# de desplegar: si dos aplicaciones comparten puerto, el smoke test de una da
# VERDE contra el /health de la otra y el despliegue parece correcto estando
# roto.
#     sudo ss -tlnp | grep :<puerto>
# coipo_cabania: 8114 asignado en app_master.xlsx (fila reserva_huesped), dominio reserva-bienestar.conaf.cl.
APP_PORT=8114

# ── Ambiente ─────────────────────────────────────────────────────────────────
# En el servidor va `production`. Con `development` quedan expuestos /docs y
# /openapi.json, que publican el mapa completo de la API a cualquiera que llegue
# al puerto.
APP_ENV=development

# EN FALSE, y no es un descuido.
#
# El servidor sirve HTTP plano: la TLS la termina un balanceador delante. Una
# cookie `Secure` no viaja por HTTP, así que con esto en `true` el login deja de
# funcionar sin una sola línea en los logs. Se pone en `true` el día que el
# certificado esté instalado en la VM, y ese día hay que acordarse.
#
# OJO CON EL NOMBRE: `SESSION_` con dos S. Con una sola —`SESION_`— la
# aplicación SÍ arranca: desde el 2026-09-08 lee el alias, lo anota en
# `advertencias` y sigue. No aborta, y es deliberado —con `rsync --delete` y sin
# rollback, abortar por una grafía deja la aplicación caída sin nada a lo que
# volver—, pero corrige el nombre igual: la advertencia sólo se ve en el log del
# arranque y ahí se pierde. Lo mismo vale para `SESION_SECRET` y `SESION_MAX_AGE`.
SESSION_HTTPS_ONLY=false

# ── Identidad del build ──────────────────────────────────────────────────────
# NO se ponen a mano en el servidor. El workflow de despliegue exporta
# `APP_COMMIT` y `APP_CONSTRUIDO_EN`, el compose los pasa como `build-args` y salen en
# /health. Sin `commit` es imposible saber si el contenedor se reconstruyó o quedó
# vivo el anterior, que desde fuera son indistinguibles.
# `APP_VERSION` NO la fija nadie: el despliegue no la exporta, así que vale el
# defecto del compose (`0.0.0`) y /health dice `version 0.0.0` junto a un commit real.
# No existe una fuente de versión en la flota (ni tags ni releases): por eso el banner
# no la muestra, en vez de mostrar un número que parecía real.
# Aquí sólo aparecen para que se sepa que existen.
# APP_VERSION=
# APP_COMMIT=
# APP_CONSTRUIDO_EN=
